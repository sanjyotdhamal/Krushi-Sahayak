# ═══════════════════════════════════════════
# KRUSHI SAHAYAK — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git!
# ═══════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB — get from mongodb.com (free tier)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/krushi-sahayak?retryWrites=true&w=majority

# JWT Secret — use any long random string
JWT_SECRET=krushi_sahayak_super_secret_key_change_this_2024
JWT_EXPIRE=7d

# Authority Login (admin panel)
AUTHORITY_USERNAME=admin
AUTHORITY_PASSWORD=admin123
AUTHORITY_JWT_SECRET=authority_secret_key_change_this

# Frontend URL (for CORS)
FRONTEND_URL=http://127.0.0.1:5500

# SMS OTP (Fast2SMS — free tier at fast2sms.com)
# Leave blank to use demo OTP: 1234
FAST2SMS_API_KEY=your_fast2sms_api_key_here
OTP_EXPIRE_MINUTES=10

# App Info
APP_NAME=Krushi Sahayak
